---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import { PERSON } from 'src/pages/index/_constants';
---

<BaseLayout title={`Page not found • ${PERSON.fullName}`}>
  <main style="display:flex;align-items:center;justify-content:center;height:100dvh;font-family:var(--font-mono);color:var(--text-dim);font-size:var(--text-sm);text-align:center;padding:2rem;">
    <div>
      <h1 style="font-family:var(--font-sans);font-size:var(--text-display);font-weight:600;color:var(--text);margin-bottom:var(--space-4);">404</h1>
      <p>Page not found.</p>
      <p style="margin-top:var(--space-4);">
        <a href="/" style="color:var(--violet-bright);text-decoration:none;">← Go home</a>
      </p>
    </div>
  </main>
</BaseLayout>
