---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import 'src/pages/portfolio/styles/index.css';
import SkipLink from 'src/pages/portfolio/_components/SkipLink/SkipLink.astro';
import Progress from 'src/pages/portfolio/_components/Progress/Progress.astro';
import Header from 'src/pages/portfolio/_components/Header/Header.astro';
import Name from 'src/pages/portfolio/_components/Name/Name.astro';
import Stack from 'src/pages/portfolio/_components/Stack/Stack.astro';
import Divider from 'src/pages/portfolio/_components/Divider/Divider.astro';
import Meta from 'src/pages/portfolio/_components/Meta/Meta.astro';
import Links from 'src/pages/portfolio/_components/Links/Links.astro';
import Footer from 'src/pages/portfolio/_components/Footer/Footer.astro';
---

<BaseLayout>
  <SkipLink />
  <Progress />

  <main class="page" id="main" tabindex="-1">
    <Header />
    <Name />
    <Stack />
    <Divider />
    <Meta />
    <Links />
    <Footer />
  </main>

  <script>
    import 'src/pages/portfolio/_init.ts';
  </script>
</BaseLayout>
