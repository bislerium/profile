---
import { PERSON, PAGE, LINKS } from 'src/pages/portfolio/_constants';

let html: string = PAGE.tagline;
for (const w of PAGE.taglineHighlights) {
  html = html.replace(w, `<span class="highlight">${w}</span>`);
}
---

<section class="meta-block" aria-labelledby="role-heading">
  <div class="meta-title">
    <h2 id="role-heading" class="label">{PERSON.jobTitle}</h2>
    <a href={LINKS.cv} class="meta-cv" target="_blank" rel="noopener noreferrer" aria-label="View CV (opens in a new tab)">
      <span class="link-icon icon-cv" aria-hidden="true"></span>
      CV
    </a>
  </div>
  <p class="meta-desc" set:html={html} />
</section>
