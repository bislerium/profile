---
import { LINKS } from 'src/pages/portfolio/_constants';
---
<nav class="links-block" aria-labelledby="links-heading">
  <h2 id="links-heading" class="label links-label">Connect</h2>
  <ul role="list">
    <li>
      <a href={LINKS.github} class="link-item" target="_blank" rel="noreferrer me" aria-label="GitHub (opens in new tab)" data-track="github_click">
        <span class="link-icon icon-github" aria-hidden="true"></span>
        GitHub<span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href={LINKS.linkedin} class="link-item" target="_blank" rel="noreferrer me" aria-label="LinkedIn (opens in new tab)" data-track="linkedin_click">
        <span class="link-icon icon-linkedin" aria-hidden="true"></span>
        LinkedIn<span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</nav>
