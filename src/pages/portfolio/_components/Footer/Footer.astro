---
import { PERSON } from 'src/pages/portfolio/_constants';
---

<footer class="page-footer" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Status</h2>
  <div class="footer-left">
    <span class="footer-name">{PERSON.shortName}</span>
    <time id="clock" datetime=""></time>
  </div>
  <div class="footer-right">
    <span class="status-available">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Available</span>
    </span>
  </div>
</footer>
