---
import BaseLayout from 'src/layouts/BaseLayout.astro';
import 'src/pages/portfolio/styles/index.css';
import SkipLink from 'src/pages/portfolio/_components/SkipLink/SkipLink.astro';
import ProgressBar from 'src/pages/portfolio/_components/ProgressBar/ProgressBar.astro';
import IndexHeader from 'src/pages/portfolio/_components/IndexHeader/IndexHeader.astro';
import NameBlock from 'src/pages/portfolio/_components/NameBlock/NameBlock.astro';
import Ecosystem from 'src/pages/portfolio/_components/Ecosystem/Ecosystem.astro';
import SectionDivider from 'src/pages/portfolio/_components/SectionDivider/SectionDivider.astro';
import MetaBlock from 'src/pages/portfolio/_components/MetaBlock/MetaBlock.astro';
import LinksBlock from 'src/pages/portfolio/_components/LinksBlock/LinksBlock.astro';
import Footer from 'src/pages/portfolio/_components/Footer/Footer.astro';
---

<BaseLayout>
  <SkipLink />
  <ProgressBar />

  <main class="page" id="main" tabindex="-1">
    <IndexHeader />
    <NameBlock />
    <Ecosystem />
    <SectionDivider />
    <MetaBlock />
    <LinksBlock />
    <Footer />
  </main>

  <script>
    import 'src/pages/portfolio/_init.ts';
  </script>
</BaseLayout>
