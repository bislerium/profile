---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from './index/components/SkipLink/SkipLink.astro';
import ProgressBar from './index/components/ProgressBar/ProgressBar.astro';
import IndexHeader from './index/components/IndexHeader/IndexHeader.astro';
import NameBlock from '../components/NameBlock.astro';
import Ecosystem from '../components/Ecosystem.astro';
import SectionDivider from './index/components/SectionDivider/SectionDivider.astro';
import MetaBlock from './index/components/MetaBlock/MetaBlock.astro';
import LinksBlock from './index/components/LinksBlock/LinksBlock.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <SkipLink />
  <ProgressBar />

  <main class="page" id="main" tabindex="-1">
    <IndexHeader />
    <NameBlock />
    <Ecosystem />
    <SectionDivider />
    <MetaBlock />
    <LinksBlock />
    <Footer />
  </main>

  <script>
    import '../scripts/init.ts';
  </script>
</BaseLayout>
