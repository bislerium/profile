---
import '../styles/index.css';

const siteUrl = Astro.site.href.replace(/\/$/, '');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bishal Gharti Chhetri',
  alternateName: 'Bishal GC',
  jobTitle: 'Software Engineer',
  url: Astro.site.href,
  sameAs: [
    'https://github.com/bislerium',
    'https://www.linkedin.com/in/bishalgc/',
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
  knowsAbout: ['.NET', 'C#', 'PostgreSQL', 'AWS', 'Docker', 'Git'],
  description: 'Software Engineer optimizing code and architecture. Building scalable systems with precision, performance, and purpose.',
};
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#512bd4" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />

    <title>Bishal Gharti Chhetri | Software Engineer</title>
    <meta name="description"
      content="Bishal Gharti Chhetri (Bishal GC) — Software Engineer. C#.NET, PostgreSQL, AWS, Docker, Git. Optimizing code and architecture. Kathmandu, Nepal." />
    <meta name="author" content="Bishal Gharti Chhetri" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.site} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Bishal Gharti Chhetri — Software Engineer" />
    <meta property="og:description"
      content="Software Engineer · C#.NET, PostgreSQL, AWS, Docker, Git · Optimizing code and architecture." />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:site_name" content="Bishal GC" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/assets/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Bishal Gharti Chhetri — Software Engineer portfolio" />
    <meta property="og:logo" content={`${siteUrl}/assets/logo/square/logo.png`} />
    <meta property="profile:first_name" content="Bishal" />
    <meta property="profile:last_name" content="Gharti Chhetri" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bishal Gharti Chhetri — Software Engineer" />
    <meta name="twitter:description"
      content="Software Engineer · C#.NET, PostgreSQL, AWS, Docker, Git · Optimizing code and architecture." />
    <meta name="twitter:image" content={`${siteUrl}/assets/og-image.png`} />
    <meta name="twitter:image:alt" content="Bishal Gharti Chhetri — Software Engineer portfolio" />

    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
    <link rel="shortcut icon" href="/assets/icons/favicon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/assets/icons/apple-touch-icon-167x167.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/icons/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/icons/apple-touch-icon-120x120.png" />
    <meta name="apple-mobile-web-app-title" content="Bishal GC" />

    <meta name="msapplication-TileImage" content="/assets/icons/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#512bd4" />

    <link rel="manifest" href="/assets/icons/site.webmanifest" />

    <link rel="me" href="https://github.com/bislerium" />
    <link rel="me" href="https://www.linkedin.com/in/bishalgc/" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" fetchpriority="high" />

  </head>

  <body>
    <slot />
  </body>
</html>
