---
import 'src/styles/index.css';
import { SITE, LINKS, PERSON, PAGE, STACK_NAMES, OG_IMAGE_ALT } from 'src/pages/portfolio/_constants';

interface Props {
  title?: string;
}

const { title = PAGE.title } = Astro.props;

const personData = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: PERSON.fullName,
  alternateName: PERSON.shortName,
  jobTitle: PERSON.jobTitle,
  url: SITE.url,
  image: `${SITE.url}/assets/logo/square/logo.png`,
  sameAs: [LINKS.github, LINKS.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: PERSON.location, addressCountry: PERSON.country },
  knowsAbout: STACK_NAMES.map(name => ({ '@type': 'Thing', name })),
  description: PAGE.description,
  mainEntityOfPage: { '@id': `${SITE.url}/#profile-page` },
};

const webSiteData = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: PERSON.fullName,
  alternateName: [PERSON.shortName, new URL(SITE.url).hostname],
  url: SITE.url,
  description: PAGE.description,
  inLanguage: 'en',
};

const profilePageData = {
  '@type': 'ProfilePage',
  '@id': `${SITE.url}/#profile-page`,
  url: SITE.url,
  name: PAGE.title,
  description: PAGE.description,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#person` },
  mainEntity: { '@id': `${SITE.url}/#person` },
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [profilePageData, personData, webSiteData],
};
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <!-- Preconnect to third-party origins -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://analytics.google.com" />
    <link rel="preconnect" href="https://www.google.com" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />

    <!-- Preload font weights used above the fold on first paint -->
    <link rel="preload" href="/fonts/switzer/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer/switzer-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono/jetbrains-mono-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
  window.dataLayer ??= [];
  window.gtag = function(){window.dataLayer.push(arguments);}
  window.gtag('js', new Date());
  window.gtag('config', gaId);
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="view-transition" content="same-origin" />
    <meta http-equiv="Content-Security-Policy"
      content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.google.com https://www.google.com.np; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://*.g.doubleclick.net https://*.cloudflareinsights.com; base-uri 'self'; form-action 'self';" />
    <meta name="theme-color" content={SITE.themeColorDark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={SITE.themeColorLight} media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <meta name="description" content={PAGE.description} />
    <meta name="author" content={PERSON.fullName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={SITE.url} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={PAGE.title} />
    <meta property="og:description" content={PAGE.description} />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:site_name" content={PERSON.fullName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${SITE.url}/assets/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="profile:first_name" content={PERSON.firstName} />
    <meta property="profile:last_name" content={PERSON.lastName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE.title} />
    <meta name="twitter:description" content={PAGE.description} />
    <meta name="twitter:image" content={`${SITE.url}/assets/og-image.png`} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/assets/icons/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/assets/icons/apple-touch-icon-167x167.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/icons/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/icons/apple-touch-icon-120x120.png" />
    <meta name="apple-mobile-web-app-title" content={PERSON.shortName} />

    <meta name="msapplication-TileImage" content="/assets/icons/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content={SITE.themeColor} />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="me" href={LINKS.github} />
    <link rel="me" href={LINKS.linkedin} />

    <!-- Agent discovery (RFC 8288 Link relations) -->
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="service-doc" href="/llms.txt" />
    <link rel="describedby" href="/.well-known/agent-skills/index.json" />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Speculation Rules: prerender same-origin pages on hover for instant navigation -->
    <script type="speculationrules" is:inline>
    {
      "prerender": [{
        "source": "document",
        "where": { "href_matches": "/*" },
        "eagerness": "moderate"
      }]
    }
    </script>

  </head>

  <body>
    <slot />
  </body>
</html>
