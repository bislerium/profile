---
import { LINKS } from '../constants';
---
<nav class="links-block" aria-label="Social and professional links">
  <h2 class="label links-label">Connect</h2>
  <ul class="links-list" role="list">
    <li>
      <a href={LINKS.github} class="link-item" target="_blank" rel="noopener noreferrer me">
        GitHub<span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href={LINKS.linkedin} class="link-item" target="_blank" rel="noopener noreferrer me">
        LinkedIn<span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href={LINKS.cv} class="link-item cv" type="application/pdf" target="_blank" rel="noopener noreferrer" aria-label="View Curriculum Vitae (opens in a new tab)">
        View CV<span class="link-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</nav>
